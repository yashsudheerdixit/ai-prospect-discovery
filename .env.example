# Environment Configuration
APP_NAME=AI-Powered Multi-Platform Prospect Discovery API
APP_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=INFO

# LLM Provider Configuration ("gemini", "openai", "anthropic", or "auto")
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-4.1-nano
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.1

# LLM API Keys (set at least one for AI-powered intent & relevance)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Authorized Search API Keys (set at least one for live multi-platform discovery)
# Recommended: Serper.dev (Google SERP), Brave Search API, or Tavily
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Optional Official Platform APIs
YOUTUBE_API_KEY=
# Legacy Google Custom Search JSON API (optional; closed to new customers, sunset Jan 2027)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Discovery & Rate Limiting Settings
MAX_RESULTS_PER_PLATFORM=6
MAX_PROSPECTS_RETURNED=20
HTTP_TIMEOUT_SECONDS=12
MAX_CONCURRENT_REQUESTS=8
ENABLE_PAGE_ENRICHMENT=true
VERIFY_PROFILE_URLS=false
CACHE_TTL_SECONDS=900
CACHE_MAX_SIZE=256
